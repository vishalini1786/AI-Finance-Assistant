# Server
PORT=5000
NODE_ENV=development

# Supabase PostgreSQL Configuration
# Note: For IPv4 networks, use the Supabase Connection Pooler (aws-0-ap-northeast-1.pooler.supabase.com)
DB_HOST=aws-0-ap-northeast-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.ffxmkslqsppshuuwzurt
DB_PASSWORD=YOUR_PRIVATE_SUPABASE_DATABASE_PASSWORD
DB_SSL=true

# JWT
JWT_SECRET=YOUR_PRIVATE_RANDOM_JWT_SECRET
JWT_EXPIRES_IN=7d

# Future AI microservice (FastAPI) - optional
AI_SERVICE_URL=http://localhost:8000

# OCR Engine (Tesseract 5) - Local Windows or container path
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Google Gemini API (Server-side only)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-1.5-flash
